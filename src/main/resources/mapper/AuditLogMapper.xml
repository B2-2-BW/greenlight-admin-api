<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.winten.greenlight.admin.db.repository.mapper.audit.AuditLogMapper">
    <sql id="columns">
        audit_id, request_id, source_path, target_site_id, target_type, target_id, action,
        reason, change_detail, created_by, created_at, created_ip
    </sql>

    <insert id="insert" parameterType="AuditLog" useGeneratedKeys="true" keyProperty="auditId">
        INSERT INTO audit_log (
            request_id, source_path, target_site_id, target_type, target_id, action,
            reason, change_detail, created_by, created_at, created_ip
        ) VALUES (
            #{requestId}, #{sourcePath}, #{targetSiteId}, #{targetType}, #{targetId}, #{action},
            #{reason}, #{changeDetail}, #{createdBy}, #{createdAt}, #{createdIp}
        )
    </insert>

    <sql id="filters">
        <where>
            <if test="targetSiteId != null and targetSiteId != ''">
                target_site_id = #{targetSiteId}
            </if>
            <if test="createdBy != null and createdBy != ''">
                AND created_by = #{createdBy}
            </if>
            <if test="targetType != null and targetType != ''">
                AND target_type = #{targetType}
            </if>
            <if test="targetId != null and targetId != ''">
                AND target_id = #{targetId}
            </if>
            <if test="action != null and action != ''">
                AND action = #{action}
            </if>
            <if test="from != null">
                AND created_at &gt;= #{from}
            </if>
            <if test="to != null">
                AND created_at &lt;= #{to}
            </if>
        </where>
    </sql>

    <select id="findPage" resultType="AuditLog">
        SELECT <include refid="columns"/>
        FROM audit_log
        <include refid="filters"/>
        ORDER BY created_at DESC, audit_id DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="count" resultType="long">
        SELECT COUNT(*)
        FROM audit_log
        <include refid="filters"/>
    </select>
</mapper>
